#!/bin/sh
set -eu

usage() {
    echo "Usage: titan-suspend-diagnostics [--save PATH]" >&2
    exit 2
}

output_path=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --save) [ "$#" -ge 2 ] || usage; output_path=$2; shift 2 ;;
        --help|-h) usage ;;
        *) usage ;;
    esac
done

if [ -n "$output_path" ]; then
    mkdir -p "$(dirname -- "$output_path")"
    umask 077
    exec > "$output_path"
fi

section() { printf '\n== %s ==\n' "$1"; }
command_report() {
    name=$1
    shift
    if command -v "$name" >/dev/null 2>&1; then
        "$@" 2>&1 || printf 'Status: command returned non-zero\n'
    else
        printf 'Status: %s is unavailable\n' "$name"
    fi
}

printf 'Titan OS suspend/resume diagnostic report\n'
printf 'Generated (UTC): '
date -u '+%Y-%m-%dT%H:%M:%SZ'
printf 'This report diagnoses behavior; it does not claim suspend/resume support.\n'

section 'Available sleep states'
if [ -r /sys/power/state ]; then
    cat /sys/power/state
else
    printf 'Status: /sys/power/state unavailable\n'
fi
if [ -r /sys/power/mem_sleep ]; then
    printf 'Memory sleep modes: '
    cat /sys/power/mem_sleep
fi

section 'Power manager'
command_report loginctl loginctl show-seat seat0 -p CanSuspend -p CanHibernate -p CanHybridSleep
command_report systemctl systemctl is-enabled power-profiles-daemon.service
command_report upower upower -d

section 'Kernel and boot'
command_report uname uname -a
command_report systemd-analyze systemd-analyze

section 'Current boot kernel errors and warnings'
command_report journalctl journalctl -b 0 -k -p warning..alert --no-pager

section 'Previous boot kernel errors and warnings'
command_report journalctl journalctl -b -1 -k -p warning..alert --no-pager

section 'Result classification'
printf 'Compatibility status: untested\n'
printf 'Run this report before and after a real suspend/resume cycle on the target MacBook.\n'
