#!/bin/sh

# System-wide fallback for live sessions whose user home is created at boot.
# Keep the shell components independent so one missing optional component does
# not prevent the other from starting.
if command -v lxqt-panel >/dev/null 2>&1; then
    lxqt-panel &
fi

if command -v pcmanfm-qt >/dev/null 2>&1; then
    pcmanfm-qt --desktop &
fi

exit 0
